#!/bin/python3
import sys
from pathlib import Path
from PIL import Image, UnidentifiedImageError

src_dir = Path(sys.argv[1])
out = Path("ASSETS")
out.mkdir(parents=True, exist_ok=True)

if not src_dir.is_dir():
    raise SystemExit(f"Not a directory: {src_dir}")

extensions = {".png", ".jpg", ".jpeg", ".bmp", ".gif", ".tif", ".tiff", ".webp"}

images = sorted(
    p for p in src_dir.iterdir()
    if p.is_file() and p.suffix.lower() in extensions
)

if not images:
    raise SystemExit(f"No supported images found in {src_dir}")



def sort_palette_by_brightness(indexed):
    raw_palette = indexed.getpalette() or []

    # Pillow palettes can contain fewer than 48 values.
    raw_palette = raw_palette[:48]
    raw_palette += [0] * (48 - len(raw_palette))

    colors = []

    for old_index in range(16):
        offset = old_index * 3
        r, g, b = raw_palette[offset:offset + 3]

        # Perceived brightness, used for ordering.
        brightness = 299 * r + 587 * g + 114 * b
        colors.append({
            "old_index": old_index,
            "rgb": (r, g, b),
            "brightness": brightness,
        })

    # Stable, deterministic brightness ordering.
    colors.sort(key=lambda c: (c["brightness"], c["old_index"]))

    def luminance(rgb):
        # WCAG relative luminance.
        channels = []
        for value in rgb:
            s = value / 255.0
            channels.append(
                s / 12.92 if s <= 0.04045
                else ((s + 0.055) / 1.055) ** 2.4
            )
        r, g, b = channels
        return 0.2126 * r + 0.7152 * g + 0.0722 * b

    def contrast_ratio(rgb1, rgb2):
        l1, l2 = sorted(
            (luminance(rgb1), luminance(rgb2)),
            reverse=True,
        )
        return (l1 + 0.05) / (l2 + 0.05)

    # Ensure index 0 and index 15 have sufficient contrast.
    # Keep the darkest colour at 0 and find the brightest colour
    # that meets the target contrast ratio for index 15.
    darkest = colors[0]
    target_contrast = 7.0

    candidates = [
        c for c in colors[1:]
        if contrast_ratio(darkest["rgb"], c["rgb"]) >= target_contrast
    ]

    if candidates:
        # Choose the brightest eligible colour.
        lightest = candidates[-1]

        # Move it to the final palette position.
        colors.remove(lightest)
        colors.append(lightest)
    else:
        # No pair in this palette meets 7:1.
        # Preserve brightness ordering rather than falsely claiming
        # that the contrast requirement has been met.
        print(
            "Warning: palette cannot achieve 7:1 contrast "
            "between its darkest and lightest colours.",
            file=sys.stderr,
        )

    remap = [0] * 16
    sorted_palette = []

    for new_index, color in enumerate(colors):
        remap[color["old_index"]] = new_index
        sorted_palette.extend(color["rgb"])

    pixels = bytes(remap[index] for index in indexed.getdata())

    return pixels, sorted_palette



def convert_image(src):
    with Image.open(src) as original:
        # Crop to the desired 640:400 aspect ratio, then resize.
        im = original.convert("RGB")
        w, h = im.size
        target_ratio = 640 / 400

        if w / h > target_ratio:
            new_w = int(h * target_ratio)
            left = (w - new_w) // 2
            im = im.crop((left, 0, left + new_w, h))
        else:
            new_h = int(w / target_ratio)
            top = (h - new_h) // 2
            im = im.crop((0, top, w, top + new_h))

        im = im.resize((640, 400), Image.Resampling.LANCZOS)

        # Quantize to 16 colours, with no dithering.
        indexed = im.quantize(
            colors=16,
            method=Image.Quantize.MEDIANCUT,
            dither=Image.Dither.NONE,
        )

        pixels, rgb_palette = sort_palette_by_brightness(indexed)

        if len(pixels) != 640 * 400:
            raise ValueError("Unexpected image size")

        # Four planar bitmaps, 80 bytes per row.
        plane_size = 80 * 400
        planes = [bytearray(plane_size) for _ in range(4)]

        for y in range(400):
            row_offset = y * 640
            plane_offset = y * 80

            for xb in range(80):
                packed = [0, 0, 0, 0]
                pixel_offset = row_offset + xb * 8

                for bit in range(8):
                    color = pixels[pixel_offset + bit]
                    mask = 0x80 >> bit

                    for p in range(4):
                        if color & (1 << p):
                            packed[p] |= mask

                for p in range(4):
                    planes[p][plane_offset + xb] = packed[p]

        palette = [(v * 15 + 127) // 255 for v in rgb_palette]

        # Store planes consecutively: plane 1, 2, 3, 4.
        packed_image = b"".join(planes)

        (out / (src.stem + ".P4")).write_bytes(packed_image)
        (out / (src.stem + ".PAL")).write_bytes(bytes(palette))


converted = 0
failed = 0

for src in images:
    try:
        convert_image(src)
        print(f"Converted: {src}")
        converted += 1
    except (OSError, ValueError, UnidentifiedImageError) as e:
        print(f"Failed: {src}: {e}", file=sys.stderr)
        failed += 1

print(f"\nFinished: {converted} converted, {failed} failed.")
print(f"Output directory: {out.resolve()}")
